# STACKUP — environment variables (example).
# Copy per app and per environment; NEVER commit real secrets.
#   apps/api  -> apps/api/.env
#   apps/web  -> apps/web/.env.local
# Separate values are used for development / test / staging / production.

# ─────────────────────────────────────────────────────────────────────────
# Backend (apps/api — FastAPI on Render)
# ─────────────────────────────────────────────────────────────────────────

# Runtime environment: development | test | staging | production
ENVIRONMENT=development

# Verbose logging / SQL echo. Never true in production.
DEBUG=false

# Async PostgreSQL URL. Neon in every real environment (ADR-002).
#   postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Local dev may use sqlite+aiosqlite:///./stackup_dev.db, but SQLite is
# REJECTED at startup in staging/production.
DATABASE_URL=sqlite+aiosqlite:///./stackup_dev.db

# The single first-party origin allowed by CORS (the Next.js BFF).
FRONTEND_ORIGIN=http://localhost:3000

# Sentry (optional; leave empty to disable — ADR-008).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Max evidence upload size in MB (Phase 6).
MAX_UPLOAD_SIZE_MB=10

# Redis for queues / cache / rate limiting (Phase 5+, Upstash — ADR-005).
# REDIS_URL=

# Object storage for evidence (Phase 6, Cloudflare R2 — ADR-006).
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Frontend (apps/web — Next.js on Vercel)
# ─────────────────────────────────────────────────────────────────────────

# Server-side base URL the BFF uses to reach FastAPI. Never hardcode a
# production URL in code; set it per environment here.
API_BASE_URL=http://localhost:8000

# Sentry for the frontend (optional).
# NEXT_PUBLIC_SENTRY_DSN=
